-- Execute once in the Supabase SQL Editor after deploying both functions and
-- replacing the two placeholders. Do not commit real secret values here.
create extension if not exists pg_cron with schema extensions;
create extension if not exists pg_net with schema extensions;
create extension if not exists supabase_vault with schema vault;

select vault.create_secret('https://<project-ref>.supabase.co', 'stockalert_project_url');
select vault.create_secret('<long-random-secret>', 'stockalert_cron_secret');

select cron.unschedule(jobid) from cron.job where jobname = 'stockalert-expiry-notifications';
select cron.schedule(
  'stockalert-expiry-notifications',
  '0 8 * * *',
  $$
    select net.http_post(
      url := (select decrypted_secret from vault.decrypted_secrets where name = 'stockalert_project_url') || '/functions/v1/send-expiry-notifications',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'x-stockalert-cron', (select decrypted_secret from vault.decrypted_secrets where name = 'stockalert_cron_secret')
      ),
      body := '{}'::jsonb
    );
  $$
);
